#!/usr/bin/env bash
# Repository-native gate for this dependency-free Node action repository.
# Resolve shared security from git-common-dir; missing prerequisites fail closed.
# This file never installs hooks, changes Git configuration, or honors skip flags.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
COMMON_DIR="$(git rev-parse --path-format=absolute --git-common-dir)"
MAIN_ROOT="$(cd "$(dirname "$COMMON_DIR")" && pwd -P)"
HOOKS_LIB="${MAIN_ROOT}/../infra-iac/hooks/lib/checks.sh"
if [ ! -f "$HOOKS_LIB" ] || [ ! -r "$HOOKS_LIB" ]; then
  printf 'ci-actions pre-push: shared security library unavailable: %s\n' "$HOOKS_LIB" >&2
  exit 1
fi
command -v node >/dev/null
if [ "$(node -p 'process.versions.node.split(".")[0]')" != 24 ]; then
  printf 'ci-actions pre-push: Node 24 is required\n' >&2
  exit 1
fi
if ! command -v gitleaks >/dev/null; then
  printf 'ci-actions pre-push: gitleaks is required for shared security\n' >&2
  exit 1
fi

cd "$REPO_ROOT"
# shellcheck source=/dev/null
source "$HOOKS_LIB"
declare -F pipeline_security >/dev/null
pipeline_security
bash -n .githooks/pre-push
node --check .githooks/run-contract-tests.mjs

# CI's Test action contracts step is authoritative. pre-push.test.mjs enforces
# exact parity and complete discovery, including the hidden workflow contracts.
CONTRACT_TESTS=(
  contract-versions.test.mjs
  lib/contract.test.mjs
  ci-admission/index.test.mjs
  ci-admission/cloud.test.mjs
  detect-ci-scope/detect-ci-scope.test.mjs
  setup-node-pnpm/resolve-pnpm-version.test.mjs
  setup-node-pnpm/cache-evidence.test.mjs
  emit-cache-observation/emit-cache-observation.test.mjs
  runner-baseline/runner-baseline.test.mjs
  resolve-job-context/resolve-job-context.test.mjs
  resolve-job-context/action.contract.test.mjs
  emit-ci-phase/emit-ci-phase.test.mjs
  setup-ci-phase-emitter/action.contract.test.mjs
  setup-ci-phase-emitter/setup-ci-phase-emitter.test.mjs
  setup-dotnet-nuget/setup-dotnet-nuget.test.mjs
  release-manifest/release-manifest.test.mjs
  package-source-v2/index.test.mjs
  download-ranged-artifact/download-ranged-artifact.test.mjs
  .github/workflows/dependabot-auto-merge.contract.test.mjs
  .github/workflows/socket-security.contract.test.mjs
  .githooks/pre-push.test.mjs
)
exec node .githooks/run-contract-tests.mjs "${CONTRACT_TESTS[@]}"
